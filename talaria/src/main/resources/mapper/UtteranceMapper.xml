<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.talaria.backend.mapper.meeting.UtteranceMapper">

  <!--
    회의 스크립트 생성용 발화 조회
    전제:
      - tl_utterances 테이블에 meeting_id 컬럼 존재
      - 시간 순서 정렬: started_ms → seq
  -->
  <select id="selectByMeetingForScript" resultType="map">
    SELECT
      speaker_id,
      text,
      started_ms,
      seq
    FROM tl_utterances
    WHERE meeting_id = #{meetingId}
    ORDER BY started_ms ASC, seq ASC
  </select>
   <!-- 회의별 발화 목록 (API용) -->
  <select id="selectByMeetingForApi" parameterType="long" resultType="map">
    SELECT
      speaker_id,
      text,
      created_at
    FROM tl_utterances
    WHERE meeting_id = #{meetingId}
    ORDER BY created_at ASC
</select>

</mapper>
